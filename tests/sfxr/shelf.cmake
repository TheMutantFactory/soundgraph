# The sfxr shelf is generated, so it has to be reproducible: `sfxr-ref shelf` run again
# must give back the seven committed patches byte for byte. The same guard as
# reproducible.cmake, for the same reason — a generated file that drifts from its
# generator is a file somebody edited by hand, and the mistake looks fixed until the next
# regeneration undoes it. That is how the game sounds went stale, twice.
#
#   cmake -DSFXR_REF=<sfxr-ref> -DSHELF=<examples/patches/sfxr> -DSCRATCH=<dir> -P shelf.cmake

file(REMOVE_RECURSE "${SCRATCH}")
file(MAKE_DIRECTORY "${SCRATCH}")

execute_process(
    COMMAND "${SFXR_REF}" shelf "${SCRATCH}"
    RESULT_VARIABLE generate_result
    OUTPUT_VARIABLE generate_output
    ERROR_VARIABLE generate_output
)
if(NOT generate_result EQUAL 0)
    message(FATAL_ERROR "sfxr-ref shelf failed:\n${generate_output}")
endif()

file(GLOB committed RELATIVE "${SHELF}" "${SHELF}/*.json")
list(LENGTH committed committed_count)
if(NOT committed_count EQUAL 7)
    message(FATAL_ERROR "Expected seven shelf patches in ${SHELF}, found ${committed_count}")
endif()

set(differing "")
foreach(patch IN LISTS committed)
    file(SHA256 "${SHELF}/${patch}" committed_hash)
    if(NOT EXISTS "${SCRATCH}/${patch}")
        list(APPEND differing "${patch} (not regenerated)")
        continue()
    endif()
    file(SHA256 "${SCRATCH}/${patch}" fresh_hash)
    if(NOT committed_hash STREQUAL fresh_hash)
        list(APPEND differing "${patch}")
    endif()
endforeach()
if(differing)
    string(REPLACE ";" "\n  " differing_text "${differing}")
    message(FATAL_ERROR
        "These shelf patches no longer match what sfxr-ref shelf writes:\n  ${differing_text}\n"
        "If the generator changed on purpose, run 'build/bin/sfxr-ref shelf "
        "examples/patches/sfxr' and 'node tools/mirror-examples.mjs', then commit both.")
endif()
message(STATUS "${committed_count} sfxr shelf patches regenerated byte-identically")
